#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadPaths as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(\PhpSsg\Cli::class)) {
    require __DIR__ . '/../src/Cli.php';
}

$cli = new \PhpSsg\Cli();
exit($cli->run($argv));
